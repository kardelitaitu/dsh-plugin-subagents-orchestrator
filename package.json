{
  "name": "dsh-plugin-subagents-orchestrator",
  "version": "1.2.0",
  "description": "Multi-endpoint load distributor and intelligent failover orchestrator for DeepSeek Harness subagents",
  "author": "Adikara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kardelitaitu/dsh-plugin-subagents-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/kardelitaitu/dsh-plugin-subagents-orchestrator/issues"
  },
  "homepage": "https://github.com/kardelitaitu/dsh-plugin-subagents-orchestrator#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "cordis",
    "deepseek",
    "subagents",
    "orchestrator",
    "load-balancer",
    "failover",
    "circuit-breaker"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "scripts/telemetry-report.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./diagnostics": {
      "types": "./lib/diagnostics.d.ts",
      "default": "./lib/diagnostics.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run",
    "ci:local": "pnpm run verify && pnpm run build && node scripts/release-check.mjs --offline",
    "release:check": "node scripts/release-check.mjs",
    "release:check:fast": "node scripts/release-check.mjs --skip-install --offline",
    "release:verify": "node scripts/verify-release.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "deploy:local": "node -e \"const fs=require('fs'); const os=require('os'); const p=require('path'); const targets=[p.join(os.homedir(), '.dsh/profiles/tauri/node_modules/dsh-plugin-subagents-orchestrator'), p.join(os.homedir(), '.dsh/profiles/web/node_modules/dsh-plugin-subagents-orchestrator')]; for (const t of targets) { if (fs.existsSync(t)) { fs.cpSync('lib', p.join(t, 'lib'), { recursive: true }); fs.copyFileSync('package.json', p.join(t, 'package.json')); console.log('Synced to ' + t); } }\"",
    "report": "node scripts/telemetry-report.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}