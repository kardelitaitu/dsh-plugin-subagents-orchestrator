{
  "name": "dsh-plugin-subagents-orchestrator",
  "version": "1.1.0",
  "description": "Multi-endpoint load distributor and intelligent failover orchestrator for DeepSeek Harness subagents",
  "author": "Adikara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kardelitaitu/dsh-plugin-subagents-orchestrator.git"
  },
  "bugs": {
    "url": "https://github.com/kardelitaitu/dsh-plugin-subagents-orchestrator/issues"
  },
  "homepage": "https://github.com/kardelitaitu/dsh-plugin-subagents-orchestrator#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "cordis",
    "deepseek",
    "subagents",
    "orchestrator",
    "load-balancer",
    "failover",
    "circuit-breaker"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./diagnostics": {
      "types": "./lib/diagnostics.d.ts",
      "default": "./lib/diagnostics.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "report": "node scripts/telemetry-report.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.4.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}